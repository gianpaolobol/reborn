APP_ENV=testing
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

DB_CONNECTION=sqlite
DB_DATABASE=storage/database/reborn.sqlite

API_VERSION=v1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

AUTH_TOKEN_TTL_SECONDS=604800
AUTH_DEFAULT_ROLE=repair_user

SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=5000
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=15728640
TRUSTED_PROXY_HEADERS=false

# CI-only safety net: demo accounts may log in with password=password even if an old seed hash is stale.
DEMO_AUTH_FALLBACK_ENABLED=true


# Step 50 — Cloud free multi-provider recognition
# CI keeps external providers unconfigured; smoke scripts still use deterministic_smoke and never depend on live cloud quotas.
AI_PHOTO_RECOGNITION_PROVIDER=auto
AI_PHOTO_RECOGNITION_ENABLED=true

# Recognition Quality Gate
# Cheap/generic providers such as Groq/OpenRouter/OCR can be preliminary.
# Final recognition requires a high quality score or verification by Gemini/OpenAI/specialized providers.
AI_RECOGNITION_QUALITY_GATE_ENABLED=true
AI_RECOGNITION_MIN_FINAL_SCORE=82
AI_RECOGNITION_MIN_PRELIMINARY_SCORE=58
AI_RECOGNITION_PROVIDER_CONFIDENCE_THRESHOLD=0.82
AI_RECOGNITION_IGNORE_LOW_TRUST_SELF_CONFIDENCE=true
AI_RECOGNITION_LOW_TRUST_MAX_SCORE=79
AI_RECOGNITION_REQUIRE_TRUSTED_VERIFIER_FOR_FINAL=true
AI_RECOGNITION_LOW_TRUST_PROVIDERS=ocrspace,groq,openrouter
AI_RECOGNITION_VERIFIER_PROVIDERS=gemini
AI_RECOGNITION_TRUSTED_FINAL_PROVIDERS=gemini
AI_RECOGNITION_VERIFY_WHEN_CODE_VISIBLE=true
AI_RECOGNITION_VERIFY_WHEN_GENERIC_PART=true
AI_RECOGNITION_VERIFY_WHEN_MISSING_FUNCTION=true
AI_RECOGNITION_ACCEPT_PRELIMINARY_WHEN_VERIFIER_UNAVAILABLE=true

AI_VISION_PROVIDER_ORDER=ocrspace,gemini,groq

OCRSPACE_ENABLED=true
OCRSPACE_API_KEY=
OCRSPACE_BASE_URL=https://api.ocr.space/parse/image
OCRSPACE_LANGUAGE=eng
OCRSPACE_ENGINE=2
OCRSPACE_TIMEOUT_SECONDS=45

GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_SECONDS=90
GROQ_MAX_OUTPUT_TOKENS=2500
GROQ_TEMPERATURE=0.1

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_OUTPUT_TOKENS=2500
OPENROUTER_TEMPERATURE=0.1

# Gemini is the trusted final verifier. It still needs a real API key in local .env.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=90
OPENAI_VISION_MAX_IMAGES=8
OPENAI_VISION_MAX_IMAGE_BYTES=20971520
OPENAI_VISION_DETAIL=original
OPENAI_VISION_WEB_SEARCH_ENABLED=true
OPENAI_REASONING_EFFORT=high
OPENAI_VISION_MAX_OUTPUT_TOKENS=4500

# Optional specialized/trainable computer vision providers.
# Add one or more to AI_VISION_PROVIDER_ORDER only after training/configuring a model:
# AI_VISION_PROVIDER_ORDER=awsrekognition,clarifai,roboflow,ocrspace,groq,openrouter,gemini
AWS_REKOGNITION_ENABLED=false
AWS_REKOGNITION_ACCESS_KEY_ID=
AWS_REKOGNITION_SECRET_ACCESS_KEY=
AWS_REKOGNITION_SESSION_TOKEN=
AWS_REKOGNITION_REGION=eu-west-1
AWS_REKOGNITION_PROJECT_VERSION_ARN=
AWS_REKOGNITION_BASE_URL=
AWS_REKOGNITION_TIMEOUT_SECONDS=45
AWS_REKOGNITION_MAX_RESULTS=10
AWS_REKOGNITION_MIN_CONFIDENCE=55
AWS_REKOGNITION_POSSIBLE_BRANDS=
AWS_REKOGNITION_APPLIANCE_CONTEXT=Da confermare.

CLARIFAI_ENABLED=false
CLARIFAI_API_KEY=
CLARIFAI_BASE_URL=https://api.clarifai.com
CLARIFAI_USER_ID=
CLARIFAI_APP_ID=
CLARIFAI_MODEL_ID=
CLARIFAI_MODEL_VERSION_ID=
CLARIFAI_TIMEOUT_SECONDS=45
CLARIFAI_MIN_CONFIDENCE=0.5
CLARIFAI_POSSIBLE_BRANDS=
CLARIFAI_APPLIANCE_CONTEXT=Da confermare.

ROBOFLOW_ENABLED=false
ROBOFLOW_MODE=hosted_model
ROBOFLOW_API_KEY=
ROBOFLOW_BASE_URL=https://detect.roboflow.com
ROBOFLOW_MODEL_ID=
ROBOFLOW_SERVERLESS_URL=https://serverless.roboflow.com
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW_ID=
ROBOFLOW_WORKFLOW_CLASSES=strap buckle, ladder lock buckle, bicycle bottom bracket support, washing machine knob, plastic clip, hinge, bracket, connector, handle, screw, knob, unknown part
ROBOFLOW_TIMEOUT_SECONDS=45
ROBOFLOW_CONFIDENCE=40
ROBOFLOW_OVERLAP=30
ROBOFLOW_MIN_CONFIDENCE=0.5
ROBOFLOW_PAYLOAD_MODE=base64_form
ROBOFLOW_POSSIBLE_BRANDS=
ROBOFLOW_APPLIANCE_CONTEXT=Da confermare.

# Re-born marketplace model finder
MARKETPLACE_SEARCH_ENABLED=true
MARKETPLACE_SEARCH_MODE=assisted_web_search
MARKETPLACE_SEARCH_FETCH_ENABLED=false
MARKETPLACE_SEARCH_TIMEOUT_SECONDS=5
MARKETPLACE_SEARCH_FETCH_QUERY_LIMIT=1
MARKETPLACE_SEARCH_MAX_RESULTS=10
MARKETPLACE_SEARCH_MIN_SCORE=70
THINGIVERSE_SEARCH_ENABLED=true
THINGIVERSE_SEARCH_MODE=web_search
THINGIVERSE_BASE_URL=https://www.thingiverse.com
PRINTABLES_SEARCH_ENABLED=true
PRINTABLES_SEARCH_MODE=web_search
PRINTABLES_BASE_URL=https://www.printables.com
MAKERWORLD_SEARCH_ENABLED=true
MAKERWORLD_SEARCH_MODE=web_search
MAKERWORLD_BASE_URL=https://makerworld.com
WEB_STL_SEARCH_ENABLED=false
WEB_STL_SEARCH_MODE=links_only
