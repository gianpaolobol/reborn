+
+/* Minimal live recognition UI: only server status, upload/progress, previews and recognition result. */
+body.minimal-live-ui {
+  min-height: 100vh;
+  margin: 0;
+  background: #f7f3ea;
+  color: #161a1f;
+  font-family: "Segoe UI", Arial, Helvetica, sans-serif;
+}
+
+body.minimal-live-ui .app-shell {
+  width: min(980px, calc(100% - 32px));
+  margin: 0 auto;
+  padding: clamp(24px, 6vw, 72px) 0;
+}
+
+.essential-recognition-app {
+  display: grid;
+  gap: 18px;
+  width: 100%;
+}
+
+.essential-status,
+.essential-progress,
+.essential-previews,
+.essential-result {
+  border: 1px solid rgba(16, 24, 40, 0.12);
+  border-radius: 24px;
+  background: #fffdf8;
+  box-shadow: 0 18px 42px rgba(16, 24, 40, 0.08);
+  padding: clamp(20px, 4vw, 32px);
+}
+
+.essential-status {
+  display: grid;
+  gap: 8px;
+  border-left: 8px solid #d5a515;
+}
+
+.essential-status.ready {
+  border-left-color: #2fbf71;
+}
+
+.essential-status.error {
+  border-left-color: #d64545;
+}
+
+.essential-status strong,
+.essential-previews strong,
+.essential-result strong,
+.essential-progress strong {
+  display: block;
+  font-size: 14px;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: #4b5563;
+}
+
+.essential-status span,
+.essential-progress p,
+.essential-previews p,
+.essential-result p {
+  margin: 0;
+  color: #263241;
+  font-size: clamp(17px, 2vw, 21px);
+  line-height: 1.45;
+}
+
+.essential-upload-button {
+  min-height: 76px;
+  width: 100%;
+  border-radius: 18px;
+  font-size: clamp(20px, 2.4vw, 30px);
+  font-weight: 900;
+}
+
+.hidden-upload-input {
+  position: absolute;
+  left: -9999px;
+  width: 1px;
+  height: 1px;
+  opacity: 0;
+}
+
+.essential-progress-head {
+  display: flex;
+  justify-content: space-between;
+  gap: 16px;
+  align-items: center;
+  margin-bottom: 14px;
+}
+
+.essential-progress-head span {
+  font-size: 18px;
+  font-weight: 900;
+  color: #111418;
+}
+
+.essential-progress-bar {
+  width: 100%;
+  height: 18px;
+  overflow: hidden;
+  border-radius: 999px;
+  background: #e8e2d6;
+}
+
+.essential-progress-bar span {
+  display: block;
+  height: 100%;
+  min-width: 0;
+  border-radius: inherit;
+  background: linear-gradient(90deg, #2fbf71, #62d889);
+  transition: width 220ms ease;
+}
+
+.essential-progress p {
+  margin-top: 12px;
+  font-size: 16px;
+}
+
+.essential-preview-grid {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 14px;
+  margin-top: 16px;
+}
+
+.essential-preview-card {
+  width: 132px;
+  margin: 0;
+  border: 1px solid rgba(16, 24, 40, 0.1);
+  border-radius: 18px;
+  background: #ffffff;
+  padding: 10px;
+}
+
+.essential-preview-card img,
+.essential-uploaded-icon {
+  display: grid;
+  place-items: center;
+  width: 112px;
+  height: 112px;
+  border-radius: 14px;
+  object-fit: cover;
+  background: #eef0f2;
+  color: #53606f;
+  font-size: 22px;
+  font-weight: 900;
+}
+
+.essential-preview-card figcaption {
+  margin-top: 8px;
+  font-size: 12px;
+  line-height: 1.2;
+  color: #4b5563;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.essential-result h2 {
+  margin: 10px 0 10px;
+  font-size: clamp(34px, 5vw, 64px);
+  line-height: 0.98;
+  letter-spacing: -0.04em;
+  color: #111418;
+}
+
+.essential-result.ready {
+  border-left: 8px solid #2fbf71;
+}
+
+.essential-result.needs-more {
+  border-left: 8px solid #d5a515;
+}
+
+.essential-result.error {
+  border-left: 8px solid #d64545;
+}
+
+.essential-result dl {
+  display: grid;
+  gap: 12px;
+  margin: 22px 0 0;
+}
+
+.essential-result dl div {
+  display: grid;
+  gap: 4px;
+  border-top: 1px solid rgba(16, 24, 40, 0.1);
+  padding-top: 12px;
+}
+
+.essential-result dt {
+  font-size: 13px;
+  font-weight: 800;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: #6b7280;
+}
+
+.essential-result dd {
+  margin: 0;
+  color: #111418;
+  font-size: 18px;
+  line-height: 1.4;
+}
+
+@media (max-width: 680px) {
+  body.minimal-live-ui .app-shell {
+    width: min(100% - 20px, 980px);
+    padding: 16px 0 32px;
+  }
+
+  .essential-status,
+  .essential-progress,
+  .essential-previews,
+  .essential-result {
+    border-radius: 18px;
+    padding: 18px;
+  }
+
+  .essential-upload-button {
+    min-height: 68px;
+  }
+}
