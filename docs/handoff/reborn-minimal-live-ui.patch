+const REBORN_MINIMAL_PREVIEWS = [];
+let REBORN_MINIMAL_PROGRESS = { phase: 'idle', percent: 0, message: 'In attesa di immagini.' };
+
+function setEssentialProgress(phase, percent, message) {
+  REBORN_MINIMAL_PROGRESS = {
+    phase: phase || 'idle',
+    percent: Math.max(0, Math.min(100, Number(percent || 0))),
+    message: message || ''
+  };
+}
+
+function rememberSelectedFilePreviews(files) {
+  while (REBORN_MINIMAL_PREVIEWS.length) {
+    const old = REBORN_MINIMAL_PREVIEWS.pop();
+    if (old && old.url) URL.revokeObjectURL(old.url);
+  }
+
+  Array.from(files || []).forEach((file, index) => {
+    if (!file || !String(file.type || '').startsWith('image/')) return;
+    REBORN_MINIMAL_PREVIEWS.push({
+      id: `${Date.now()}-${index}`,
+      name: file.name || `immagine-${index + 1}.jpg`,
+      size: file.size || 0,
+      url: URL.createObjectURL(file)
+    });
+  });
+}
